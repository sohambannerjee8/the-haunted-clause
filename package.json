{
  "name": "the-haunted-clause",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest --run",
    "test:coverage": "vitest --run --coverage",
    "test:e2e": "playwright test --grep-invert @screenshots",
    "check:secrets": "node scripts/secret-scan.mjs --tracked",
    "check:rules": "node scripts/check-repo-rules.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:history": "node scripts/secret-scan.mjs --history",
    "check:trace": "node scripts/check-traceability.mjs",
    "precompute:samples": "tsx --conditions=react-server scripts/precompute-samples.mts",
    "screenshots": "playwright test --grep @screenshots --project=no-key"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "jsdom": "^31.0.1",
    "license-checker": "^25.0.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20.9"
  }
}
